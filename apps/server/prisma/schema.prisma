generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum TestStatus {
  untested
  passed
  failed
  blocked
  retest
}

model User {
  id         BigInt    @id @default(autoincrement())
  email      String    @unique
  name       String
  globalRole String    @default("user")
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  projectMembers ProjectMember[]
  groupMembers   UserGroupMember[]
  apiTokens      ApiToken[]
  auditLogs      AuditLog[]      @relation("AuditActor")
  assignedRuns   TestRun[]       @relation("RunAssignee")
  assignedPlans  TestPlan[]      @relation("PlanAssignee")
  assignedPlanEntries TestPlanEntry[] @relation("PlanEntryAssignee")
  assignedTests  TestInstance[]  @relation("TestAssignee")
  createdResults TestResult[]     @relation("ResultCreator")
  createdDefectLinks ResultDefectLink[] @relation("ResultDefectLinkCreator")
  createdProjects Project[]       @relation("ProjectCreatedBy")
  updatedProjects Project[]       @relation("ProjectUpdatedBy")
  activityEvents  ActivityEvent[] @relation("ActivityActor")
  notifications   Notification[]
  notificationPreferences NotificationPreference[]
  emailOutbox     EmailOutbox[]
  testSubscriptions TestSubscription[]
  executionComments ExecutionComment[] @relation("ExecutionCommentAuthor")
  updatedAccessDefaults InstanceAccessDefaults[] @relation("InstanceAccessDefaultsUpdatedBy")
  createdGroups         UserGroup[] @relation("UserGroupCreatedBy")
}

model UserGroup {
  id          BigInt    @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   BigInt?

  createdByUser User? @relation("UserGroupCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  members       UserGroupMember[]

  @@index([deletedAt])
}

model UserGroupMember {
  id        BigInt   @id @default(autoincrement())
  groupId   BigInt
  userId    BigInt
  createdAt DateTime @default(now())

  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Project {
  id          BigInt    @id @default(autoincrement())
  name        String
  description String?
  projectType String    @default("single_repo")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   BigInt?
  updatedBy   BigInt?

  createdByUser User? @relation("ProjectCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("ProjectUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  members      ProjectMember[]
  suites       TestSuite[]
  cases        TestCase[]
  runs         TestRun[]
  plans        TestPlan[]
  milestones   Milestone[]
  configurationGroups ConfigurationGroup[]
  requirements Requirement[]
  sharedSteps  SharedStep[]
  attachments  Attachment[]
  defectIntegrationSetting DefectIntegrationSetting?
  customFields CustomField[]
  customStatuses CustomStatus[]
  caseTemplates CaseTemplate[]
  apiTokens    ApiToken[]
  auditLogs    AuditLog[]
  activityEvents ActivityEvent[]
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  emailOutbox EmailOutbox[]
  webhookSubscriptions WebhookSubscription[]
  webhookDeliveryAttempts WebhookDeliveryAttempt[]
  importJobs   ImportJob[]
  exportJobs   ExportJob[]
  savedReports SavedReport[]
  scheduledReports ScheduledReport[]
  testSubscriptions TestSubscription[]
  customRoles      CustomRole[]
  executionComments ExecutionComment[]

  @@index([deletedAt])
}

model CustomRole {
  id          BigInt    @id @default(autoincrement())
  projectId   BigInt
  name        String
  systemName  String
  permissions String[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectMembers ProjectMember[]

  @@unique([projectId, systemName])
  @@index([projectId])
}

model ProjectMember {
  id           BigInt    @id @default(autoincrement())
  projectId    BigInt
  userId       BigInt
  role         String
  customRoleId BigInt?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    BigInt?
  updatedBy    BigInt?

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  customRole CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([customRoleId])
}

model TestSuite {
  id            BigInt    @id @default(autoincrement())
  projectId     BigInt
  name          String
  description   String?
  isMaster      Boolean   @default(false)
  isBaseline    Boolean   @default(false)
  parentSuiteId BigInt?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     BigInt?
  updatedBy     BigInt?

  project      Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  parentSuite  TestSuite? @relation("SuiteBaselineTree", fields: [parentSuiteId], references: [id], onDelete: SetNull)
  childSuites  TestSuite[] @relation("SuiteBaselineTree")
  sections     Section[]
  cases        TestCase[]
  runs         TestRun[]
  planEntries  TestPlanEntry[]

  @@index([projectId])
  @@index([projectId, isMaster])
  @@index([projectId, isBaseline])
  @@index([parentSuiteId])
  @@index([deletedAt])
}

model Section {
  id              BigInt    @id @default(autoincrement())
  suiteId         BigInt
  parentSectionId BigInt?
  name            String
  displayOrder    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       BigInt?
  updatedBy       BigInt?

  suite         TestSuite @relation(fields: [suiteId], references: [id], onDelete: Restrict)
  parentSection Section?  @relation("SectionTree", fields: [parentSectionId], references: [id], onDelete: SetNull)
  childSections Section[] @relation("SectionTree")
  cases         TestCase[]

  @@index([suiteId])
  @@index([parentSectionId])
  @@index([suiteId, parentSectionId, displayOrder, id])
}

model TestCase {
  id             BigInt    @id @default(autoincrement())
  projectId      BigInt
  suiteId        BigInt
  sectionId      BigInt
  displayOrder   Int       @default(0)
  title          String
  preconditions  String?
  expectedResult String?
  mission            String?
  goals              String?
  aiInput            String?
  aiExpectedOutput   String?
  priority       String?
  caseType       String?
  estimate       String?
  refs           String?
  labels         String[]
  automationKey  String?
  externalId     String?
  customValues   Json      @default("{}")
  caseTemplateId BigInt?
  lockVersion    Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?
  deletedAt      DateTime?
  createdBy      BigInt?
  updatedBy      BigInt?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  suite        TestSuite     @relation(fields: [suiteId], references: [id], onDelete: Restrict)
  section      Section       @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  caseTemplate CaseTemplate? @relation(fields: [caseTemplateId], references: [id], onDelete: SetNull)
  steps        TestCaseStep[]
  scenarios    TestCaseScenario[]
  instances TestInstance[]
  versions  TestCaseVersion[]
  requirements CaseRequirement[]

  @@unique([projectId, automationKey])
  @@unique([projectId, externalId])
  @@index([projectId])
  @@index([sectionId])
  @@index([sectionId, displayOrder, id])
  @@index([projectId, sectionId, deletedAt])
  @@index([projectId, archivedAt, deletedAt])
  @@index([automationKey])
  @@index([externalId])
  @@index([caseTemplateId])
}

model Requirement {
  id          BigInt    @id @default(autoincrement())
  projectId   BigInt
  key         String
  title       String
  description String?
  status      String    @default("active")
  externalUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  caseLinks CaseRequirement[]

  @@unique([projectId, key])
  @@index([projectId, status])
}

model CaseRequirement {
  id            BigInt   @id @default(autoincrement())
  caseId         BigInt
  requirementId  BigInt
  createdAt      DateTime @default(now())

  testCase     TestCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requirement  Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([caseId, requirementId])
  @@index([requirementId, caseId])
}

model TestCaseVersion {
  id             BigInt   @id @default(autoincrement())
  caseId         BigInt
  versionNo      Int
  title          String
  priority       String?
  caseType       String?
  preconditions  String?
  stepsSnapshot  Json
  customValuesSnapshot Json @default("{}")
  attachmentSnapshots Json @default("[]")
  changeReason   String?
  createdAt      DateTime @default(now())

  testCase TestCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, versionNo])
  @@index([caseId, createdAt])
}

model SharedStep {
  id        BigInt    @id @default(autoincrement())
  projectId BigInt
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy BigInt?
  updatedBy BigInt?

  project Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  entries SharedStepEntry[]
  caseSteps TestCaseStep[]

  @@index([projectId])
  @@index([projectId, deletedAt])
}

model SharedStepEntry {
  id             BigInt    @id @default(autoincrement())
  sharedStepId   BigInt
  stepOrder      Int
  content        String
  expectedResult String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  sharedStep SharedStep     @relation(fields: [sharedStepId], references: [id], onDelete: Cascade)
  caseSteps  TestCaseStep[]

  @@unique([sharedStepId, stepOrder])
  @@index([sharedStepId])
}

model TestCaseStep {
  id                BigInt    @id @default(autoincrement())
  caseId            BigInt
  stepOrder         Int
  content           String
  expectedResult    String?
  sharedStepId      BigInt?
  sharedStepEntryId BigInt?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  createdBy         BigInt?
  updatedBy         BigInt?

  testCase          TestCase          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sharedStep        SharedStep?       @relation(fields: [sharedStepId], references: [id], onDelete: SetNull)
  sharedStepEntry   SharedStepEntry?  @relation(fields: [sharedStepEntryId], references: [id], onDelete: SetNull)

  @@unique([caseId, stepOrder])
  @@index([caseId])
  @@index([sharedStepId])
  @@index([sharedStepEntryId])
}

model TestCaseScenario {
  id            BigInt    @id @default(autoincrement())
  caseId        BigInt
  scenarioOrder Int
  name          String
  content       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  testCase      TestCase           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  resultResults TestResultScenario[]

  @@unique([caseId, scenarioOrder])
  @@index([caseId])
}

model Milestone {
  id                BigInt    @id @default(autoincrement())
  projectId         BigInt
  parentMilestoneId BigInt?
  name              String
  description       String?
  startDate         DateTime?
  dueDate           DateTime?
  isCompleted       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  createdBy         BigInt?
  updatedBy         BigInt?

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  parent   Milestone?  @relation("MilestoneHierarchy", fields: [parentMilestoneId], references: [id], onDelete: SetNull)
  children Milestone[] @relation("MilestoneHierarchy")
  runs     TestRun[]
  plans    TestPlan[]

  @@index([projectId])
  @@index([parentMilestoneId])
}

model TestPlan {
  id          BigInt    @id @default(autoincrement())
  projectId   BigInt
  milestoneId BigInt?
  name        String
  description String?
  status      String    @default("open")
  assignedTo  BigInt?
  refs        String?
  startDate   DateTime?
  dueOn       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   BigInt?
  updatedBy   BigInt?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee  User?      @relation("PlanAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  runs      TestRun[]
  entries   TestPlanEntry[]

  @@index([projectId])
  @@index([milestoneId])
  @@index([assignedTo])
}

model TestRun {
  id          BigInt    @id @default(autoincrement())
  projectId   BigInt
  suiteId     BigInt
  milestoneId BigInt?
  planId      BigInt?
  name        String
  description String?
  includeAll  Boolean   @default(false)
  status      String    @default("open")
  assignedTo  BigInt?
  environment String?
  metadata    Json?
  startedAt   DateTime?
  dueOn       DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   BigInt?
  updatedBy   BigInt?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  suite     TestSuite  @relation(fields: [suiteId], references: [id], onDelete: Restrict)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  plan      TestPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  assignee  User?      @relation("RunAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  instances   TestInstance[]
  planEntries TestPlanEntry[]

  @@index([projectId])
  @@index([suiteId])
  @@index([milestoneId])
  @@index([status])
  @@index([projectId, status, createdAt])
}

model TestInstance {
  id                    BigInt      @id @default(autoincrement())
  runId                 BigInt
  caseId                BigInt
  status                TestStatus  @default(untested)
  titleSnapshot         String
  prioritySnapshot      String?
  typeSnapshot          String?
  estimateSnapshot      String?
  automationKeySnapshot String?
  externalIdSnapshot    String?
  caseLockVersionAtRun  Int?
  latestResultId        BigInt?
  assignedTo            BigInt?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?
  createdBy             BigInt?
  updatedBy             BigInt?

  run          TestRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase      TestCase   @relation(fields: [caseId], references: [id], onDelete: Restrict)
  latestResult  TestResult? @relation("LatestResult", fields: [latestResultId], references: [id], onDelete: SetNull)
  assignee      User?       @relation("TestAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  results       TestResult[] @relation("InstanceResults")
  subscriptions TestSubscription[]

  @@unique([runId, caseId])
  @@index([runId])
  @@index([runId, status])
  @@index([caseId])
  @@index([status])
  @@index([assignedTo])
  @@index([automationKeySnapshot])
  @@index([externalIdSnapshot])
}

model TestResult {
  id             BigInt     @id @default(autoincrement())
  testInstanceId BigInt
  status         TestStatus
  comment          String?
  elapsed          String?
  version          String?
  aiActualOutput   String?
  aiQualityRating  Int?
  aiLatencyMs      Int?
  aiTraces         String?
  defects        String[]
  customValues   Json       @default("{}")
  source         String     @default("manual")
  metadata       Json?
  createdBy      BigInt?
  createdAt      DateTime   @default(now())

  instance           TestInstance @relation("InstanceResults", fields: [testInstanceId], references: [id], onDelete: Cascade)
  createdByUser      User?        @relation("ResultCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  linkedAsLatestFor  TestInstance[] @relation("LatestResult")
  stepResults        TestResultStep[]
  scenarioResults    TestResultScenario[]
  attachments        Attachment[]   @relation("ResultAttachments")
  defectLinks        ResultDefectLink[]

  @@index([testInstanceId, createdAt])
  @@index([status])
  @@index([source])
  @@index([status, createdAt])
  @@index([source, createdAt])
}

model ResultDefectLink {
  id                   BigInt    @id @default(autoincrement())
  resultId             BigInt
  defectKey            String
  url                  String?
  remoteStatus         String?
  remoteStatusLabel    String?
  remoteStatusSyncedAt DateTime?
  providerIssueId      String?
  createMode           String?
  createdBy            BigInt?
  createdAt            DateTime  @default(now())
  deletedAt            DateTime?

  result       TestResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  createdByUser User?     @relation("ResultDefectLinkCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([resultId, defectKey])
  @@index([resultId, createdAt])
}

model DefectIntegrationSetting {
  id                BigInt   @id @default(autoincrement())
  projectId         BigInt   @unique
  provider          String   @default("custom")
  isEnabled         Boolean  @default(false)
  createMode        String   @default("url_template")
  issueUrlTemplate  String?
  defaultProjectKey String?
  apiBaseUrl        String?
  apiToken          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model TestResultStep {
  id           BigInt     @id @default(autoincrement())
  resultId     BigInt
  stepOrder    Int
  status       TestStatus
  actualResult String?
  comment      String?
  createdAt    DateTime   @default(now())

  result TestResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, stepOrder])
  @@index([resultId])
}

model TestResultScenario {
  id             BigInt     @id @default(autoincrement())
  resultId       BigInt
  caseScenarioId BigInt
  status         TestStatus
  comment        String?
  createdAt      DateTime   @default(now())

  result       TestResult       @relation(fields: [resultId], references: [id], onDelete: Cascade)
  caseScenario TestCaseScenario @relation(fields: [caseScenarioId], references: [id], onDelete: Restrict)

  @@unique([resultId, caseScenarioId])
  @@index([resultId])
  @@index([caseScenarioId])
}

model ExecutionComment {
  id         BigInt    @id @default(autoincrement())
  projectId  BigInt
  entityType String
  entityId   BigInt
  parentId   BigInt?
  content    String
  createdBy  BigInt?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser User?              @relation("ExecutionCommentAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  parent        ExecutionComment?  @relation("ExecutionCommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies       ExecutionComment[] @relation("ExecutionCommentThread")

  @@index([projectId, entityType, entityId, createdAt])
  @@index([parentId])
}

model TestPlanEntry {
  id             BigInt    @id @default(autoincrement())
  planId         BigInt
  name           String
  environment    String?
  suiteId        BigInt?
  runId          BigInt?
  assignedTo     BigInt?
  refs           String?
  startDate      DateTime?
  dueOn          DateTime?
  includeAll     Boolean   @default(true)
  includeCaseIds Json?
  excludeCaseIds Json?
  isIncluded     Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      BigInt?
  updatedBy      BigInt?

  plan  TestPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  suite TestSuite? @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  run   TestRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  assignee User?  @relation("PlanEntryAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  configurations TestPlanEntryConfiguration[]

  @@index([planId])
  @@index([runId])
  @@index([assignedTo])
}

model ConfigurationGroup {
  id           BigInt   @id @default(autoincrement())
  projectId    BigInt
  name         String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configurations Configuration[]

  @@unique([projectId, name])
  @@index([projectId, displayOrder])
}

model Configuration {
  id           BigInt   @id @default(autoincrement())
  groupId      BigInt
  name         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  group       ConfigurationGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  planEntries TestPlanEntryConfiguration[]

  @@unique([groupId, name])
  @@index([groupId, displayOrder])
}

model TestPlanEntryConfiguration {
  id              BigInt @id @default(autoincrement())
  planEntryId     BigInt
  configurationId BigInt

  planEntry     TestPlanEntry  @relation(fields: [planEntryId], references: [id], onDelete: Cascade)
  configuration Configuration  @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@unique([planEntryId, configurationId])
}

model Attachment {
  id          BigInt    @id @default(autoincrement())
  projectId   BigInt
  entityType  String
  entityId    BigInt
  resultId    BigInt?
  fileName    String
  contentType String?
  storagePath String
  fileSize    BigInt?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   BigInt?
  updatedBy   BigInt?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  result  TestResult? @relation("ResultAttachments", fields: [resultId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([entityType, entityId])
}

model ApiToken {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt
  projectId  BigInt?
  name       String
  tokenHash  String    @unique
  scopes     String[]  @default(["automation:read", "automation:write"])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([revokedAt])
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  projectId   BigInt?
  actorUserId BigInt?
  action      String
  entityType  String
  entityId    String
  changes     Json?
  requestId   String?
  createdAt   DateTime @default(now())

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actorUser User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
}

model ActivityEvent {
  id          BigInt   @id @default(autoincrement())
  projectId   BigInt
  actorUserId BigInt?
  entityType  String
  entityId    String
  eventType   String
  title       String
  body        String?
  payload     Json?
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorUser User?   @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  notifications Notification[]
  webhookDeliveryAttempts WebhookDeliveryAttempt[]

  @@index([projectId, createdAt])
  @@index([projectId, entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model WebhookSubscription {
  id        BigInt   @id @default(autoincrement())
  projectId BigInt
  scope     String   @default("project")
  event     String
  targetUrl String
  secret    String
  isActive  Boolean  @default(true)
  consecutiveFailures Int @default(0)
  disabledAt DateTime?
  lastFailureAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdBy BigInt?
  updatedBy BigInt?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveryAttempts WebhookDeliveryAttempt[]

  @@index([scope, isActive, event])
  @@index([projectId, isActive, event])
  @@index([projectId, deletedAt])
}

model TestSubscription {
  id        BigInt   @id @default(autoincrement())
  projectId BigInt
  userId    BigInt
  testId    BigInt
  createdAt DateTime @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  test    TestInstance @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([userId, testId])
  @@index([testId])
  @@index([projectId, userId])
}

model WebhookDeliveryAttempt {
  id              BigInt    @id @default(autoincrement())
  projectId       BigInt
  webhookId       BigInt
  activityEventId BigInt?
  event           String
  targetUrl       String
  payload         Json
  signature       String
  status          String    @default("pending")
  attemptNo       Int       @default(1)
  responseStatus  Int?
  responseBody    String?
  error           String?
  nextRetryAt     DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  webhook       WebhookSubscription @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  activityEvent ActivityEvent?      @relation(fields: [activityEventId], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
  @@index([webhookId, createdAt])
  @@index([activityEventId])
}

model NotificationPreference {
  id                  BigInt    @id @default(autoincrement())
  userId              BigInt
  projectId           BigInt
  assignmentEnabled   Boolean   @default(true)
  failedResultEnabled Boolean   @default(true)
  activityEnabled     Boolean   @default(true)
  mentionEnabled      Boolean   @default(true)
  digestEnabled       Boolean   @default(false)
  lastDigestSentAt    DateTime?
  updatedAt           DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

model EmailOutbox {
  id              BigInt    @id @default(autoincrement())
  userId          BigInt
  projectId       BigInt
  recipientEmail  String
  kind            String
  subject         String
  bodyText        String
  status          String    @default("pending")
  attemptNo       Int       @default(1)
  nextRetryAt     DateTime?
  sentAt          DateTime?
  error           String?
  notificationIds Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt, createdAt])
  @@index([userId, projectId, kind, createdAt])
}

model Notification {
  id              BigInt    @id @default(autoincrement())
  userId          BigInt
  projectId       BigInt
  activityEventId BigInt?
  type            String
  title           String
  body            String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activityEvent ActivityEvent? @relation(fields: [activityEventId], references: [id], onDelete: SetNull)

  @@index([userId, projectId, readAt, createdAt])
  @@index([projectId, createdAt])
  @@index([activityEventId])
}

model CustomField {
  id           BigInt    @id @default(autoincrement())
  projectId    BigInt
  name         String
  systemName   String
  scope        String    @default("case")
  fieldType    String
  options      Json?
  isRequired   Boolean   @default(false)
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  visibility   Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    BigInt?
  updatedBy    BigInt?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, systemName])
  @@index([projectId, scope, isActive, displayOrder])
  @@index([projectId, isActive, displayOrder])
  @@index([projectId, deletedAt])
}

model CustomStatus {
  id              BigInt    @id @default(autoincrement())
  projectId       BigInt
  name            String
  systemName      String
  canonicalStatus String
  color           String    @default("#64748b")
  isFinal         Boolean   @default(false)
  isUntested      Boolean   @default(false)
  isSystem        Boolean   @default(false)
  isActive        Boolean   @default(true)
  displayOrder    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       BigInt?
  updatedBy       BigInt?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, systemName])
  @@index([projectId, isActive, displayOrder])
  @@index([projectId, deletedAt])
}

model CaseTemplate {
  id           BigInt    @id @default(autoincrement())
  projectId    BigInt
  systemKey    String?
  name         String
  description  String?
  fields       Json
  isDefault    Boolean   @default(false)
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    BigInt?
  updatedBy    BigInt?

  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases TestCase[]

  @@unique([projectId, name])
  @@unique([projectId, systemKey])
  @@index([projectId, isActive, displayOrder])
  @@index([projectId, deletedAt])
}

model ImportJob {
  id        BigInt   @id @default(autoincrement())
  projectId BigInt
  type      String
  status    String   @default("pending")
  dryRun    Boolean  @default(false)
  summary   Json?
  errors    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy BigInt?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([status])
}

model ExportJob {
  id        BigInt   @id @default(autoincrement())
  projectId BigInt
  type      String
  status    String   @default("pending")
  filters   Json?
  summary   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy BigInt?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([status])
}

model SavedReport {
  id          BigInt    @id @default(autoincrement())
  projectId   BigInt
  name        String
  reportType  String
  filters     Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   BigInt?

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scheduledReports  ScheduledReport[]

  @@index([projectId, deletedAt, updatedAt])
  @@index([projectId, reportType])
}

model InstanceAccessDefaults {
  id                       Int      @id @default(1)
  defaultProjectMemberRole String   @default("viewer")
  newProjectAccessMode     String   @default("creator_only")
  updatedAt                DateTime @updatedAt
  updatedBy                BigInt?

  updatedByUser User? @relation("InstanceAccessDefaultsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
}

model ScheduledReport {
  id               BigInt    @id @default(autoincrement())
  projectId        BigInt
  name             String
  savedReportId    BigInt?
  reportType       String
  filters          Json?
  intervalMinutes  Int
  recipientEmails  Json
  enabled          Boolean   @default(true)
  lastRunAt        DateTime?
  nextRunAt        DateTime?
  lastExportJobId  BigInt?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdBy        BigInt?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  savedReport SavedReport? @relation(fields: [savedReportId], references: [id], onDelete: SetNull)

  @@index([projectId, deletedAt, enabled, nextRunAt])
  @@index([savedReportId])
}
